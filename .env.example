# Copy to .env for local overrides. Values here are LOCAL DEVELOPMENT DEFAULTS ONLY — never put real
# credentials in this file or in the repository. In AWS, secrets come from Secrets Manager (see docs/security.md).

# PostgreSQL (docker compose service "postgres")
POSTGRES_DB=catalogsentinel
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog_local_dev
DB_URL=jdbc:postgresql://localhost:5432/catalogsentinel
DB_USERNAME=catalog
DB_PASSWORD=catalog_local_dev

# Local AWS emulation: ElasticMQ (SQS API) and Moto (S3 API). The AWS SDK requires credentials to be
# present; emulators accept any value.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
SQS_ENDPOINT=http://localhost:9324
S3_ENDPOINT=http://localhost:5000
LISTING_EVENTS_QUEUE=catalog-listing-events
LISTING_EVENTS_DLQ=catalog-listing-events-dlq
CHANGE_EVENTS_QUEUE=catalog-change-events
CHANGE_EVENTS_DLQ=catalog-change-events-dlq
BATCH_BUCKET=catalogsentinel-batch

# API security (disabled locally; enabled in the aws profile). Keys are compared as SHA-256 hashes.
CATALOGSENTINEL_SECURITY_ENABLED=false

# Tracing: 0.0 keeps trace ids in logs without exporting spans; the "observability" compose profile sets 1.0
TRACING_SAMPLING_PROBABILITY=0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
