# syntax=docker/dockerfile:1.7
# Builds either Spring Boot service from the repository root:
#   docker build -f apps/Dockerfile.spring --build-arg APP=catalog-api --build-arg PORT=8080 .
#   docker build -f apps/Dockerfile.spring --build-arg APP=ingestion-worker --build-arg PORT=8081 .
ARG APP=catalog-api

# The build stage runs on the build machine's platform (jars are platform-independent); only the runtime stage
# follows --platform, so an arm64 image builds quickly on an x86-64 runner.
FROM --platform=$BUILDPLATFORM maven:3.9-eclipse-temurin-21 AS build
ARG APP
WORKDIR /src
# Dependency layer first so source edits do not re-download the world.
COPY pom.xml ./
COPY libs/catalog-domain/pom.xml libs/catalog-domain/
COPY libs/event-contracts/pom.xml libs/event-contracts/
COPY libs/catalog-core/pom.xml libs/catalog-core/
COPY libs/platform-adapters/pom.xml libs/platform-adapters/
COPY apps/catalog-api/pom.xml apps/catalog-api/
COPY apps/ingestion-worker/pom.xml apps/ingestion-worker/
RUN --mount=type=cache,target=/root/.m2 mvn -B -q -pl apps/${APP} -am dependency:go-offline -DexcludeReactor=true || true
COPY db db
COPY tests/fixtures tests/fixtures
COPY libs libs
COPY apps/catalog-api apps/catalog-api
COPY apps/ingestion-worker apps/ingestion-worker
RUN --mount=type=cache,target=/root/.m2 mvn -B -pl apps/${APP} -am -DskipTests package
RUN java -Djarmode=tools -jar apps/${APP}/target/${APP}.jar extract --layers --launcher --destination /extracted

FROM eclipse-temurin:21-jre
ARG PORT=8080
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app
WORKDIR /app
COPY --from=build /extracted/dependencies/ ./
COPY --from=build /extracted/spring-boot-loader/ ./
COPY --from=build /extracted/snapshot-dependencies/ ./
COPY --from=build /extracted/application/ ./
USER app
ENV PORT=${PORT} \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"
EXPOSE ${PORT}
# Liveness only: a dependency outage must not get the container restarted (readiness reports dependencies).
HEALTHCHECK --interval=15s --timeout=3s --start-period=60s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT}/actuator/health/liveness" || exit 1
ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]
